{
  "name": "@andyzheung/ccmr",
  "version": "1.2.4",
  "description": "A lightweight API gateway for routing Claude Code requests to multiple AI models (Forked with GLM-5.2 and MiniMax M2.5 support)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ccmr-plus": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js start",
    "dev": "ts-node src/cli.ts start",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "llm",
    "gateway",
    "router",
    "deepseek",
    "glm",
    "glm-5",
    "glm-5.2",
    "minimax",
    "minimax-m2.5",
    "qwen",
    "kimi",
    "anthropic"
  ],
  "author": "andyzheung",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/andyzheung/Claude-Code-Model-Router.git"
  },
  "bugs": {
    "url": "https://github.com/andyzheung/Claude-Code-Model-Router/issues"
  },
  "homepage": "https://github.com/andyzheung/Claude-Code-Model-Router#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "config"
  ],
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
